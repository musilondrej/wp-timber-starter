{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer format)",
      "Bash(composer analyse)",
      "Bash(composer i18n)",
      "Bash(composer lint:*)",
      "Bash(composer audit)",
      "Bash(npm run build)",
      "Bash(npm run build:zip)",
      "Bash(npm audit *)",
      "Bash(vendor/bin/php-cs-fixer *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/twig-cs-fixer *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./auth.json)",
      "Edit(./vendor/**)",
      "Edit(./dist/**)",
      "Edit(./node_modules/**)",
      "Bash(wp db *)",
      "Bash(wp * delete *)",
      "Bash(npm publish *)"
    ]
  },
  "enabledMcpjsonServers": [
    "wordpress"
  ]
}
