# Needs npm >= 11.10 (enforced by "engines" and engine-strict).

# Most malicious releases are pulled within hours; never install anything younger than 7 days.
min-release-age=7

# No install scripts from dependencies, the usual way npm worms spread. esbuild and Tailwind
# ship native binaries as optional dependencies, so they don't need them.
ignore-scripts=true

save-exact=true

# Fail on an npm too old for min-release-age instead of silently ignoring it.
engine-strict=true
