{# WordPress returns these links already escaped; autoescape would escape them twice. #}
{% if pagination.pages|length > 1 %}
    <nav class="pagination" aria-label="{{ __('Pagination', 'wp-timber-starter') }}">
        {% if pagination.prev %}
            <a href="{{ pagination.prev.link|esc_url }}" rel="prev">{{ __('Previous', 'wp-timber-starter') }}</a>
        {% endif %}
        {% for page in pagination.pages %}
            {% if page.link %}
                <a href="{{ page.link|esc_url }}">{{ page.title }}</a>
            {% else %}
                <span{% if page.current %} aria-current="page"{% endif %}>{{ page.title }}</span>
            {% endif %}
        {% endfor %}
        {% if pagination.next %}
            <a href="{{ pagination.next.link|esc_url }}" rel="next">{{ __('Next', 'wp-timber-starter') }}</a>
        {% endif %}
    </nav>
{% endif %}
